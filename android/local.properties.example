# Add your API keys here. Copy this to local.properties and fill in values.
# Do NOT commit local.properties (it is in .gitignore).
#
# Flutter/Android Studio may create local.properties with sdk.dir. Add this line:
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

GOOGLE_MAPS_API_KEY=

# Places / Geocoding / Directions call maps.googleapis.com, which refuses a key
# restricted to Android apps. Use the separate web-services key here. Blank
# falls back to GOOGLE_MAPS_API_KEY above.
GOOGLE_MAPS_WEB_KEY=

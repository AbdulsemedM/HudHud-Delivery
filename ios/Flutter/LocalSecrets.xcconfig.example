// Copy this file to LocalSecrets.xcconfig and set your real keys.
// LocalSecrets.xcconfig is gitignored.
GOOGLE_MAPS_API_KEY=YOUR_IOS_GOOGLE_MAPS_API_KEY

// Google Sign-In (iOS): MUST match REVERSED_CLIENT_ID in ios/GoogleService-Info.plist
// (Firebase → Project settings → Your iOS app). Mismatch breaks the OAuth redirect.
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.284030196855-g6brvhkvg2gcj0p3fjkklrl81ctec033

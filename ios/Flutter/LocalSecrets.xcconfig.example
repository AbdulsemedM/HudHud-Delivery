// Copy this file to LocalSecrets.xcconfig and set your real keys.
// LocalSecrets.xcconfig is gitignored.
GOOGLE_MAPS_API_KEY=YOUR_IOS_GOOGLE_MAPS_API_KEY

// Google Sign-In (iOS): paste the REVERSED_CLIENT_ID value from Firebase
// Project settings → Your iOS app → GoogleService-Info.plist (download / open plist).
// Example: com.googleusercontent.apps.1234567890-abcdefghijklmnop
GOOGLE_IOS_REVERSED_CLIENT_ID=

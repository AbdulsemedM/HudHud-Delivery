# Copy this file to .env and add your keys. Do not commit .env (it is in .gitignore).
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
#
# Google Sign-In (Android ID token): Web client ID from Firebase cannot live in .env for Dart;
# pass at build/run time:
#   flutter run --dart-define=GOOGLE_SIGN_IN_SERVER_CLIENT_ID=xxxx.apps.googleusercontent.com
#
# iOS also needs GOOGLE_IOS_REVERSED_CLIENT_ID in ios/Flutter/LocalSecrets.xcconfig (see example file)
# and a complete ios/Runner/GoogleService-Info.plist from Firebase (CLIENT_ID + REVERSED_CLIENT_ID).

GOOGLE_MAPS_API_KEY=

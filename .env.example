# Copy to `.env` and fill in secrets. Do not commit `.env` (.gitignore).
#
# API base — include trailing /api/
BASE_URL=https://api.hudhuddelivery.com/api/
#
# Google Maps (also read by Android Gradle from root `.env`)
GOOGLE_MAPS_API_KEY=

# iOS: GOOGLE_IOS_REVERSED_CLIENT_ID in ios/Flutter/LocalSecrets.xcconfig
# and a complete ios/Runner/GoogleService-Info.plist from Firebase.

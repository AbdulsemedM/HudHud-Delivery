# Copy to `.env` and fill in real values (never commit `.env`).
#
# THE FILE MUST EXIST FOR THE BUILD TO SUCCEED. `pubspec.yaml` declares `.env`
# under assets, so without it asset bundling fails outright:
#
#   Error detected in pubspec.yaml:
#   No file or variants found for asset: .env.
#
# CI creates it from secrets; this file is what a developer copies, and what CI
# reads BASE_URL from when the APP_BASE_URL secret is not set.

# API base URL. `ApiEnv.baseUrl` normalises it to end in `/api/`, so either form
# works.
#
# THERE IS NO FALLBACK. Unlike the rider app, this one has no compiled default:
# `ApiEnv.baseUrl` throws StateError('BASE_URL is missing in .env') and
# `loadAppEnv()` rethrows if the file will not load. A build with this missing
# succeeds and then dies on the first API call.
BASE_URL=https://api.hudhuddelivery.com

# Google Maps / Places key, read by BOTH:
#   - android/app/build.gradle, which prefers THIS file over
#     android/local.properties, and defaults it to an empty string if absent
#   - lib/app/services/google_places_service.dart, via the Android BuildConfig
#
# Leave it empty or wrong and nothing fails: build.gradle's own warning says
# what then ships — "Google Maps will show a blank screen."
#
# The key must be usable from Android: either unrestricted, or restricted to
# Android apps by package name plus signing SHA-1, with "Maps SDK for Android"
# enabled on its Google Cloud project. A key restricted to HTTP referrers is
# rejected by the Android SDK.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

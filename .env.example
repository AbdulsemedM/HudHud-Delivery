# Copy to `.env` and fill in secrets. Do not commit `.env` (.gitignore).
#
# API base — include trailing /api/
BASE_URL=https://api.hudhuddelivery.com/api/
#
# Google Maps (also read by Android Gradle from root `.env`)
GOOGLE_MAPS_API_KEY=

# Google Sign-In
# - iOS: set GOOGLE_IOS_REVERSED_CLIENT_ID in ios/Flutter/LocalSecrets.xcconfig to the
#   exact REVERSED_CLIENT_ID from ios/GoogleService-Info.plist (see LocalSecrets.xcconfig.example).
# - Android (com.hudhud.userapp): keep android/app/google-services.json in sync with Firebase
#   (debug + release SHA-1s). Re-download after adding SHA fingerprints:
#   firebase apps:sdkconfig android 1:284030196855:android:ba8023df0b1adaa0bc3a72 -o android/app/google-services.json
#   If using Play App Signing, also add the Play Console SHA-1 in Firebase.
